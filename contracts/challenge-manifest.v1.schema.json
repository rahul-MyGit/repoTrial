{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repotrial.dev/contracts/challenge-manifest.v1.schema.json",
  "title": "RepoTrial challenge manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "slug", "version", "title", "summary", "language",
    "runtime", "sourceRoot", "entrypoint", "baselineCommand",
    "visibleTestCommand", "baselineExpected", "allowedPatchPaths", "visibleTestPaths", "limits"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "language": { "const": "go" },
    "runtime": { "type": "string", "pattern": "^go[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "sourceRoot": { "$ref": "#/$defs/relativePath", "description": "Directory within the challenge package containing the participant repository; '.' means the package root." },
    "entrypoint": { "$ref": "#/$defs/relativePath", "description": "Path relative to sourceRoot." },
    "baselineCommand": { "$ref": "#/$defs/command", "description": "Argument vector executed with sourceRoot as the working directory, without a shell." },
    "visibleTestCommand": { "$ref": "#/$defs/command", "description": "Argument vector executed with sourceRoot as the working directory, without a shell." },
    "baselineExpected": {
      "type": "object", "additionalProperties": false,
      "required": ["exitCode", "outputContains"],
      "properties": {
        "exitCode": { "type": "integer", "minimum": 1, "maximum": 255 },
        "outputContains": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "description": "Author validation checks the failing baseline output against this stable marker."
    },
    "allowedPatchPaths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePathOrGlob" },
      "description": "Paths or globs relative to sourceRoot. Matching files may be changed only through accepted AI patches."
    },
    "visibleTestPaths": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePathOrGlob" },
      "description": "Paths or globs relative to sourceRoot; visible tests are never writable."
    },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["cpuMillis", "memoryMiB", "timeoutSeconds", "outputKiB"],
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 100, "maximum": 4000 },
        "memoryMiB": { "type": "integer", "minimum": 64, "maximum": 4096 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "outputKiB": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "relativePathOrGlob": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "command": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}
